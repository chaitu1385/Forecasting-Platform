{
  "name": "forecasting-product-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lock:integrity": "node scripts/lock-integrity.cjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --reporter=verbose",
    "test:pw": "npx playwright test --project=chromium",
    "test:auth-browser": "playwright test --config=playwright.auth.config.ts",
    "test:runtime-browser": "node -e \"require('node:fs').cpSync('.next/static', '.next/standalone/.next/static', { recursive: true })\" && playwright test --config=playwright.runtime.config.ts",
    "test:pw:headed": "npx playwright test --project=chromium --headed",
    "test:pw:all": "npx playwright test",
    "test:pw:integration": "npx playwright test --project=chromium --grep @integration",
    "test:pw:m5daily": "npx playwright test --project=chromium --grep @m5daily"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "plotly.js": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "^2.6.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
